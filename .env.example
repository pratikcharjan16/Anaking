# Safe template — copy to .env and fill in real values locally.
# Never commit the resulting .env file or real credentials.

# Application security
ANAKING_ENV=development
# Replace with a long random value before deployment. Production rejects this default.
SECRET_KEY=change-me-in-production

# Protected username/password administrator — signs in at the separate /admin-login page.
# Password sign-in for this account stays DISABLED while ADMIN_PASSWORD is empty,
# so set a strong value here (and restart the app) to be able to log in as admin.
ADMIN_USERNAME=Anaking.admin
ADMIN_PASSWORD=

# Optional: comma-separated Google emails that become approved admins on first sign-in.
# When SMTP is also configured (below), these addresses receive an e-mail for every
# new Google sign-up waiting for admin approval (100 Kart pts are added on approval).
ADMIN_EMAILS=

# Google OAuth 2.0 Web Client (both values are required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional when a hosting proxy generates the wrong external callback URL.
# Register this exact URL in Google Cloud Console, e.g. https://example.com/auth/google/callback.
# GOOGLE_REDIRECT_URI=

# Optional local AI service
LOCAL_AI_URL=
LOCAL_AI_MODEL=

# Optional: where account-owned data lives (users, Kart ledger, password resets).
# Defaults to users.db beside the survey DB; studies/responses stay in DB_PATH.
# USERS_DB_PATH=/var/lib/anaking/users.db

# Optional SMTP credentials for invites, survey launches and demo alerts.
# Full provider recipes (Gmail App Passwords, Workspace, Microsoft 365, SendGrid,
# SES, Mailgun) and a troubleshooting table: docs/smtp-setup.md
# You can also set these from Admin -> Account desk -> Mail & invitations, which
# writes data/mail.json (0600) and sends a test message.
BEACON_SMTP_HOST=
BEACON_SMTP_PORT=587
BEACON_SMTP_USER=
BEACON_SMTP_PASSWORD=
BEACON_SMTP_FROM=
BEACON_SMTP_TLS=starttls

# Where "Request a demo" leads are announced (falls back to ADMIN_EMAILS).
DEMO_NOTIFY_EMAIL=

# ---- machine translation (Globalize / child surveys) -----------------------
# A translated child survey needs a reachable translation service on the *server*.
# auto = paid providers first (when configured), then the keyless Google endpoint,
# then MyMemory; none = switch network translation off (manual editor + CSV still work).
TRANSLATE_PROVIDER=auto
# GOOGLE_TRANSLATE_API_KEY=
# DEEPL_API_KEY=
# DEEPL_FREE=1
# LIBRETRANSLATE_URL=https://lt.example.com
# LIBRETRANSLATE_API_KEY=
# MYMEMORY_EMAIL=
# TRANSLATE_TIMEOUT=8

# ---- Export to Google Sheets ----------------------------------------------
# A Google OAuth *web* client id whose authorised JavaScript origins include this
# deployment. Only the public client id is used; the browser receives the token.
# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_SCOPE=https://www.googleapis.com/auth/spreadsheets

# Future API integrations — add provider-specific names only when needed.
# These examples are comments and are not read by the current application.
# EXAMPLE_API_KEY=
# EXAMPLE_API_SECRET=
